# Virtual environments
.venv/
.venv_*/
**/.venv*/
venv/
env/

# Local Python/tooling folders
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Training outputs
lightning_logs/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.hdf5
*.joblib
checkpoints/
wandb/

# Model/output artifact folders
**/models/
**/logs/

# TensorRT export/calibration/build artifacts (Jetson_monitoring/ INT8 pipeline).
# NOTE: this directory used to be named "monitoring/" -- if it gets renamed again,
# update this pattern too, or it'll silently stop matching (a slash in the middle
# root-anchors it to a literal path, it won't match anywhere the dir shows up).
Jetson_monitoring/trt/

# Data files (optional - if you don't want to track large datasets)
*.png
*.jpg
*.jpeg
data/

# Secrets (webhook URLs, API keys, etc.) -- see webhook_secrets_example.py for the
# template. Named webhook_secrets.py, not secrets.py -- see that file's docstring.
Jetson_monitoring/Monitor/webhook_secrets.py

# Dashboard Basic Auth password -- see dashboard_secrets_example.py for the template.
Jetson_monitoring/Monitor/dashboard_secrets.py